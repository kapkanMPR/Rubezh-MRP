/* Values and breakpoints mirror FieldCamp/style.css 0.12.81.
   Grid widths, safe area, and viewport classes are set by NativeCampView. */
.camp-root { background-color:#141b18; color:#e8e8d6; font-size:16px; flex-direction:column; overflow:hidden; }
Label { white-space:normal; min-width:0; flex-shrink:1; margin:0; padding:0; }
.camp-button { color:#e8e8d6; background-color:#2b362c; border-width:1px; border-color:#52604c; border-radius:3px; padding:12px 18px; margin:0; white-space:normal; flex-shrink:0; -unity-text-align:middle-center; }
.camp-button:hover { background-color:#3b4939; border-color:#dfbb70; }
.camp-button:focus { border-color:#dfbb70; }
.camp-button:disabled { opacity:0.4; }
.camp-button:active { translate:0 1px; }
.row { flex-direction:row; align-items:center; }
.row > * { margin-right:8px; }
.wrap { flex-wrap:wrap; }
.grow { flex-grow:1; flex-shrink:1; min-width:0; }
.centered { -unity-text-align:middle-center; }
.strong { -unity-font-style:bold; }
.scroll { flex-grow:1; flex-shrink:1; min-width:0; min-height:0; }
.scroll > .unity-scroll-view__content-viewport { min-width:0; min-height:0; }
.unity-scroller--vertical { width:9px; }
.unity-scroller--horizontal { height:9px; }
.unity-scroller__low-button,.unity-scroller__high-button { display:none; }
.unity-base-slider__dragger { background-color:#68785c; border-width:0; border-radius:5px; }
.unity-base-slider__tracker { background-color:#1c2921; }
.dropdown > .unity-base-field__input { color:#e8e8d6; background-color:#202a23; border-color:#455045; padding:7px 9px; }
.unity-base-popup-field__input { border-width:1px; }

.header { height:78px; flex-shrink:0; flex-direction:row; align-items:center; padding:10px 28px; background-color:#19221d; border-bottom-width:1px; border-bottom-color:#62694b; }
.brand { background-color:transparent; border-width:0; padding:0; flex-direction:row; align-items:center; -unity-text-align:middle-left; max-width:44%; }
.brand:hover { background-color:transparent; }
.brand-image { width:48px; height:48px; margin-right:12px; }
.brand-title { font-size:27px; -unity-font-style:bold; letter-spacing:5px; white-space:nowrap; }
.brand-small { font-size:10px; letter-spacing:2px; color:#a1ad9a; margin-top:3px; }
.brand-copy { flex-shrink:1; }
.battle-red { color:#fff1d6; background-color:#a7352d; border-width:1px; border-color:#d26a53; border-radius:4px; font-size:18px; letter-spacing:1.17px; -unity-font-style:bold; padding:12px 18px; }
.battle-red:hover { background-color:#b63e2f; }
.battle-top { position:absolute; left:50%; top:50%; translate:-50% -50%; }
.resources { position:absolute; right:74px; max-width:43%; flex-direction:row; align-items:center; }
.resource { color:#dfbb70; font-size:14px; margin-right:6px; white-space:nowrap; }
.balance { color:#dfbb70; -unity-font-style:bold; font-size:14px; padding:4px 7px; flex-shrink:1; }
.settings-button { position:absolute; right:28px; padding:8px 12px; }
.isolated-brand { letter-spacing:2px; font-size:16px; -unity-font-style:bold; }
.main { flex-grow:1; flex-shrink:1; min-height:0; min-width:0; overflow:hidden; }
.nav { height:79px; flex-shrink:0; justify-content:center; background-color:#1a231e; border-top-width:1px; border-top-color:#566149; padding:0 20px; }
.nav-button { flex-grow:1; flex-basis:0; max-width:220px; height:100%; background-color:transparent; border-width:0; border-top-width:3px; border-top-color:transparent; border-radius:0; color:#aab5a1; -unity-font-style:bold; padding:8px; margin-right:3px; }
.nav-button.active { color:#dfbb70; border-top-color:#dfbb70; background-color:rgba(223,187,112,0.08); }
.eyebrow { font-size:11px; letter-spacing:3px; color:#dfbb70; margin-bottom:9px; }
.h1 { font-size:25px; margin:0; }
.h2 { font-size:25px; margin-bottom:12px; }
.h3 { font-size:20px; margin-bottom:12px; }
.sub { color:#a1ad9a; font-size:13px; }
.paragraph { margin-top:8px; margin-bottom:12px; color:#b9c3b0; }
.gold { background-color:#dfbb70; border-color:#dfbb70; color:#21271d; -unity-font-style:bold; }
.gold:hover { background-color:#f1d193; }
.gold-text,.qty { color:#dfbb70; }
.qty { -unity-font-style:bold; }
.on { background-color:#b6c889; color:#192219; }
.list-page { width:100%; max-width:1450px; align-self:center; flex-grow:1; flex-shrink:1; min-height:0; height:100%; padding:12px 24px; overflow:hidden; }
.list-heading { flex-shrink:0; margin-bottom:8px; }
.filter-toggle { min-width:40px; min-height:36px; padding:7px; }
.list-tabs,.list-footer { flex-shrink:0; margin-bottom:8px; }
.list-footer { margin-top:8px; margin-bottom:0; }
.list-tabs .camp-button,.list-footer .camp-button { padding:7px 14px; font-size:13px; }
.list-scroll { padding-right:3px; padding-bottom:4px; }
.cards-grid { align-items:stretch; flex-shrink:0; }
.card { padding:0; overflow:hidden; background-color:#2b372e; border-color:#53644f; justify-content:flex-start; align-items:stretch; -unity-text-align:upper-left; }
.card-title { font-size:18px; -unity-font-style:bold; padding:12px 10px; min-height:46px; }
.card-image { width:100%; height:135px; padding:4px; }
.card-portrait { width:100%; height:160px; }
.card-footer { margin-top:auto; padding:10px; min-height:48px; background-color:#1b251e; font-size:14px; align-items:center; }
.card-footer > .grow { margin-right:8px; }
.class-image { height:150px; width:100%; padding:18px; }
.badge { position:absolute; left:9px; top:52px; background-color:#1c2820; border-width:1px; border-color:#6b785d; font-size:11px; padding:4px 7px; }
.skill-book { position:absolute; top:4px; right:4px; width:18px; height:18px; background-color:#20281f; color:#efd080; border-radius:4px; -unity-text-align:middle-center; }
.portrait { min-width:0; min-height:0; flex-shrink:0; overflow:visible; }
.portrait-canvas,.portrait-layer,.portrait-gun { position:absolute; }
.camp-scene { flex-grow:1; min-height:0; overflow:hidden; background-color:#566344; }
.camp-background { position:absolute; width:100%; height:100%; }
.camp-title { position:absolute; left:35px; top:30px; }
.home-title { font-size:38px; margin-bottom:10px; }
.camp-intro { width:230px; font-size:13px; color:#d2d6ba; }
.camp-label { position:absolute; background-color:rgba(27,42,32,0.91); border-color:rgba(156,170,120,0.44); font-size:11px; letter-spacing:1px; padding:9px 16px; }
.camp-person { position:absolute; width:42px; height:53px; }
.camp-footer { position:absolute; left:35px; bottom:25px; }
.camp-footer .camp-button { margin-top:10px; }
.sortie { position:absolute; right:30px; bottom:23px; width:300px; padding:18px; background-color:rgba(23,36,30,0.92); border-width:1px; border-color:#8b9870; }
.flow-bar { flex-shrink:0; background-color:#1c2921; border-bottom-width:1px; border-bottom-color:#56644d; padding:8px 12px; }
.flow-bar .eyebrow { margin-bottom:0; font-size:11px; color:#bdbfa5; letter-spacing:2px; }
.flow-title { -unity-font-style:bold; flex-shrink:1; }
.prepare { flex-grow:1; flex-shrink:1; min-width:0; min-height:0; flex-direction:row; padding:13px 16px; }
.prepare > * { margin-right:16px; }
.panel { background-color:#202c24; border-width:1px; border-color:#455045; padding:12px; }
.roster { width:22%; flex-grow:0; }
.stats { width:23%; flex-grow:0; }
.doll-area { flex-grow:1; flex-shrink:1; padding:0 2px; }
.member { flex-direction:row; -unity-text-align:middle-left; align-items:center; padding:5px; margin-top:4px; margin-bottom:4px; width:100%; }
.member.on { background-color:#484b2b; color:#e8e8d6; border-color:#dfbb70; }
.member-picture { width:40px; height:48px; margin-right:8px; }
.member .skill-book { width:14px; height:14px; top:2px; right:2px; }
.member-name { font-size:16px; }
.roster-note { margin-top:8px; }
.dropdown { margin:0 0 5px; flex-shrink:0; }
.doll-title { min-height:40px; margin-bottom:1px; }
.prep-name { font-size:28px; }
.doll-title .eyebrow { margin-bottom:0; }
.doll { height:245px; width:100%; align-items:center; }
.doll-picture { width:58%; height:100%; }
.slot { position:absolute; width:110px; height:45%; padding:4px; justify-content:center; align-items:center; }
.slot.weapon { left:0; top:1px; }
.slot.armor { right:0; top:1px; }
.slot.rig { left:0; bottom:1px; }
.slot.extra { right:0; bottom:1px; }
.slot-image { width:82px; max-width:100%; height:42px; margin:1px 0; }
.slot-label { width:100%; -unity-text-align:middle-center; font-size:13px; }
.kit-cells { justify-content:center; align-items:flex-start; margin-top:8px; }
.pockets { justify-content:center; margin-top:3px; margin-bottom:6px; }
.pocket { width:70px; height:62px; padding:3px; margin-right:4px; font-size:12px; justify-content:center; align-items:center; }
.pocket-image { width:85%; height:34px; }
.pocket-text { -unity-text-align:middle-center; font-size:11px; }
.pocket-group { margin-right:15px; }
.prep-tools { margin-top:4px; padding-bottom:3px; flex-shrink:0; flex-wrap:wrap; }
.stat { padding:9px 0; border-bottom-width:1px; border-bottom-color:#455045; align-items:center; }
.stat-value { -unity-text-align:middle-right; max-width:55%; -unity-font-style:bold; }
.stats .stat { font-size:15px; }
.stats .camp-button { margin-top:5px; }
.notice { padding:8px; color:#dfbb70; font-size:13px; }
.operations { flex-grow:1; flex-shrink:1; min-height:0; padding:16px 20px; background-color:#19241e; align-items:center; }
.op-switch { flex-wrap:wrap; background-color:#131c17; border-width:1px; border-color:#59634e; padding:3px; border-radius:5px; flex-shrink:0; }
.op-switch .camp-button { padding:8px 17px; border-width:0; background-color:transparent; color:#a6af9e; }
.op-switch .camp-button.on { background-color:#56644d; color:#f3e5ba; }
.sector-scroll { width:100%; }
.sector-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { align-items:center; justify-content:flex-start; }
.sector { align-items:center; width:100%; max-width:780px; padding:3px; }
.op-title { font-size:38px; margin-bottom:3px; -unity-text-align:middle-center; }
.sector-carousel { margin:5px 0; justify-content:center; }
.arrow { border-radius:50%; width:42px; height:42px; padding:0; font-size:26px; }
.sector-seal { width:218px; height:218px; margin:0 30px; }
.op-badge { width:112px; height:112px; margin:8px; }
.op-track { width:100%; max-width:440px; justify-content:space-between; margin:7px 0; }
.op-track > .op-dot { width:9.5%; height:36px; margin:0 0 4px; font-size:12px; padding:0; border-radius:50%; color:#b8c0b0; background-color:#233127; border-color:#6c7665; }
.op-dot.won { background-color:#caad64; color:#201d12; border-color:#e3c884; }
.op-dot.selected { border-width:2px; border-color:#f2df99; }
.op-actions { justify-content:center; padding:6px; flex-shrink:0; }
.dev-pass { align-self:center; margin:8px 0; color:#e5bfa4; border-color:#916d58; font-size:13px; padding:5px 13px; }
.modal-overlay { position:absolute; left:0; top:0; right:0; bottom:0; background-color:rgba(8,15,11,0.878); align-items:center; justify-content:center; }
.modal { width:90%; max-width:820px; max-height:88%; flex-shrink:1; background-color:#232e27; border-width:1px; border-color:#758262; border-radius:5px; overflow:hidden; }
.sheet-head,.sheet-foot { padding:9px 14px; background-color:#24332a; flex-shrink:0; }
.sheet-head { border-bottom-width:1px; border-bottom-color:#52634d; }
.modal-title { font-size:24px; flex-grow:1; flex-shrink:1; }
.close { padding:4px 11px; margin-left:auto; }
.sheet-content { padding:10px 14px; flex-grow:1; flex-shrink:1; min-height:0; }
.sheet-foot { justify-content:flex-end; flex-wrap:wrap; border-top-width:1px; border-top-color:#52634d; }
.sheet-foot .camp-button { margin-top:4px; }
.detail { align-items:flex-start; margin:10px 0; }
.detail-image,.detail-portrait { width:24%; height:200px; flex-shrink:0; margin-right:20px; }
.detail-body { min-width:0; flex-basis:0; flex-grow:1; flex-shrink:1; }
.detail-body .camp-button { margin:3px 0; padding:8px 12px; }
.detail .stat { font-size:14px; }
.offer-class { width:100%; height:100px; }
.growth-line { margin:8px 0; font-size:13px; }
.growth-actions { margin:9px 0; }
.growth-actions .camp-button { font-size:13px; padding:7px 10px; margin:3px; }
.kit-inspect { align-items:center; }
.kit-figure { width:38%; height:300px; margin-right:20px; }
.kit-controls .eyebrow { margin-top:8px; margin-bottom:5px; }
.kit-controls .camp-button { padding:4px 8px; margin:2px; }
.setting { margin:3px 0; padding:3px 0; min-height:30px; flex-shrink:0; }
.volume-slider { width:46%; }
.import-text { height:160px; }
.toast { position:absolute; bottom:90px; left:50%; translate:-50% 0; max-width:85%; padding:12px 24px; color:#172319; background-color:#d8c187; }
.training-page { padding-top:3px; padding-bottom:3px; }
.training-strip { padding:3px 6px; border-bottom-width:1px; border-bottom-color:#465347; font-size:13px; flex-shrink:0; }
.training-strip .camp-button { font-size:12px; padding:5px 9px; }
.training-strip .growth-line { margin:0; }
.tree-scroll { background-color:rgba(21,29,24,0.22); border-width:1px; border-color:#3a483d; border-radius:8px; }
.skill-tree { position:relative; flex-shrink:0; }
.tree-mark { position:absolute; color:#c9c7a0; font-size:10px; background-color:#151d18; }
.skill-node { position:absolute; width:114px; height:46px; padding:3px 6px; font-size:11px; background-color:#253127; color:#eeeeee; border-color:#5f6b5f; border-radius:5px; justify-content:center; align-items:flex-start; -unity-text-align:middle-left; }
.skill-caption { font-size:9px; color:#b1b9aa; margin-bottom:2px; }
.skill-name { font-size:11px; }
.skill-node.ready { border-color:#dfbc69; background-color:#393828; }

.requirement { padding:7px 9px; margin:4px 0; border-left-width:3px; border-radius:3px; }
.requirement.met { color:#a1dfa8; background-color:#243a2d; border-left-color:#a1dfa8; }
.requirement.missing { color:#ffaaa3; background-color:#402c2c; border-left-color:#ffaaa3; }

.shipment { height:530px; }
.shipment-head { padding:12px 18px 9px; background-color:#24342a; border-bottom-width:1px; border-bottom-color:#53624c; flex-shrink:0; }
.shipment-scroll { padding:8px 15px; }
.shipment-stage { align-items:center; flex-shrink:0; }
.crate { width:160px; height:90px; }
.drop-row { align-items:stretch; margin:8px 0; }
.drop-card { flex-shrink:1; margin-right:6px; padding:6px 3px; align-items:center; background-color:#2f3e30; border-color:#687858; border-top-width:2px; border-top-color:#c4b482; }
.drop-card.selected { border-color:#dfbb70; }
.drop-image { width:100%; height:84px; }
.drop-name { font-size:15px; -unity-text-align:middle-center; }
.drop-caption { font-size:10px; color:#b9c3ae; -unity-text-align:middle-center; }
.drop-info { min-height:36px; color:#d0d8c8; font-size:13px; margin-top:5px; }
.shipment-foot { flex-shrink:0; padding:9px 14px; background-color:#223027; border-top-width:1px; border-top-color:#53624c; justify-content:flex-end; }
.shipment-foot .camp-button { padding:8px 13px; min-height:36px; }
.plan { width:100%; height:260px; }
/* CSS viewport equivalents. */
.small-header .resource { font-size:14px; }
.compact { font-size:14px; }
.compact .camp-button { padding:6px 10px; }
.compact .header,.short .header { height:40px; padding:3px 12px; }
.compact .brand-title,.short .brand-title { font-size:19px; letter-spacing:3px; }
.compact .brand-image,.short .brand-image { width:30px; height:30px; margin-right:8px; }
.compact .brand-small,.short .brand-small { display:none; }
.compact .balance { font-size:12px; }
.compact .settings-button { right:12px; padding:6px 10px; }
.compact .resources { right:54px; }
.compact .nav { height:44px; padding:0 6px; }
.compact .nav-button { padding:4px 6px; font-size:12px; }

.compact .battle-top { padding:6px 12px; font-size:18px; }
.compact .list-page { padding:6px 14px; }
.compact .list-heading { margin-bottom:5px; }
.compact .h1 { font-size:22px; }
.compact .eyebrow { font-size:9px; letter-spacing:2px; margin-bottom:4px; }
.compact .sub { font-size:11px; }
.compact .list-tabs .camp-button,.compact .list-footer .camp-button { padding:5px 12px; font-size:12px; }
.compact .card { padding:0; }
.compact .card-title { padding:6px 8px; font-size:14px; min-height:29px; }
.compact .card-image { height:90px; }
.compact .card-portrait { height:90px; }
.compact .class-image { height:86px; padding:7px; }
.compact .card-footer { padding:7px 8px; font-size:11px; min-height:29px; }
.compact .badge { top:30px; left:6px; font-size:9px; padding:3px 5px; }
.compact .toast { bottom:50px; padding:8px 14px; }
.compact .prepare { padding:7px 10px; }
.compact .prepare > * { margin-right:9px; }
.compact .panel { padding:8px; }
.compact .member { padding:3px 5px; margin:3px 0; }
.compact .member-name { font-size:12px; }
.compact .member-picture { width:28px; height:32px; margin-right:6px; }
.compact .member .sub { font-size:10px; }
.compact .doll-title { min-height:33px; }
.compact .prep-name { font-size:22px; }
.compact .doll { height:170px; }
.compact .slot { width:92px; padding:3px; }
.compact .slot-label { font-size:11px; }
.compact .slot-image { height:29px; width:54px; }
.compact .pocket { width:64px; height:49px; padding:3px; }
.compact .pocket-image { height:25px; width:85%; }
.compact .pocket-text { font-size:9px; }
.compact .stats .h3 { font-size:17px; margin-bottom:5px; }
.compact .stats .stat { font-size:12px; padding:7px 0; }
.compact .stats .paragraph { font-size:12px; margin:8px 0; }
.compact .stats .camp-button { font-size:12px; padding:8px; }
.compact .camp-title { left:15px; top:12px; }
.compact .home-title { font-size:26px; }
.compact .camp-intro,.compact .camp-footer .sub { display:none; }
.compact .camp-footer { left:15px; bottom:12px; }
.compact .sortie { right:12px; bottom:12px; width:220px; padding:10px; }
.compact .sortie .h3 { font-size:17px; margin-bottom:5px; }
.compact .camp-label { padding:7px 10px; font-size:10px; }
.compact .detail-image,.compact .detail-portrait { height:180px; }
.compact .modal-title { font-size:21px; }
.compact .sheet-head,.compact .sheet-foot { padding:4px 10px; }
.compact .sheet-content { padding:7px 10px; }
.compact .kit-figure { height:180px; }
.compact .skill-node { padding:3px 6px; }
.short .prepare { padding:4px 7px; }
.short .panel { padding:5px 7px; }
.short .member { padding:2px 4px; margin:1px 0; }
.short .member-picture { width:25px; height:30px; }
.short .member-name { font-size:11px; }
.short .member .sub { font-size:9px; }
.short .roster .eyebrow { font-size:9px; }
.short .roster .dropdown > .unity-base-field__input { padding:4px; font-size:11px; }
.short .doll { height:135px; }
.short .doll-title { min-height:30px; }
.short .doll-title .camp-button { padding:4px 7px; }
.short .prep-name { font-size:20px; }
.short .slot { width:82px; }
.short .slot-label { font-size:10px; }
.short .slot-image { height:20px; }
.short .pocket { width:54px; height:38px; }
.short .pocket-image { height:18px; }
.short .stats .stat { padding:3px 0; font-size:11px; }
.short .stats .h3 { font-size:15px; }
.short .stats .paragraph { font-size:11px; margin:4px 0; }
.short .flow-bar { padding:4px 8px; }
.short .flow-bar .camp-button { padding:5px 9px; }
.short .operations { padding:5px 9px; }
.short .war-sector { padding-left:165px; }
.short .war-sector .sector-carousel { position:absolute; left:0; top:50%; translate:0 -50%; }
.short .sector-seal { width:105px; height:105px; margin:0 5px; }
.short .arrow { width:30px; height:30px; padding:0; }
.short .op-title { font-size:21px; }
.short .sector .h2 { font-size:17px; margin-bottom:2px; }
.short .sector .paragraph { font-size:12px; margin:2px 0; }
.short .op-track { max-width:305px; margin:4px 0; }
.short .op-dot { height:25px; }
.short .op-badge { width:45px; height:45px; margin:0; }
.short .op-actions { padding:3px; }
.short .op-actions .camp-button,.short .op-switch .camp-button { padding:4px 12px; }
.short .dev-pass { padding:3px 8px; margin:4px 0; font-size:11px; }
.short .shipment-head { padding:5px 12px; }
.short .shipment-scroll { padding:5px 12px; }
.short .shipment-foot { padding:4px 10px; }
.short .shipment-foot .camp-button { min-height:32px; padding:4px 10px; }
.short .crate { height:46px; }
.short .drop-image { height:60px; }
.short .drop-name { font-size:12px; }
.short .drop-card { padding:4px; }
.short .drop-info { min-height:24px; }
.narrow .header { height:60px; padding:8px 12px; }
.narrow .brand-image,.narrow .brand-small { display:none; }
.narrow .brand-title { font-size:17px; letter-spacing:1px; }
.narrow .battle-top { min-width:65px; font-size:14px; padding:7px 8px; }
.narrow .settings-button { right:8px; padding:5px; }
.narrow .resources { right:37px; }
.narrow .resource,.narrow .balance { font-size:10px; }
.narrow .resource { margin-right:3px; }
.narrow .balance { padding:2px; }
.narrow .nav { height:62px; padding:0 5px; }
.narrow .nav-button { font-size:10px; padding:5px; }
.narrow .list-page { padding:8px 12px; }
.narrow .h1 { font-size:24px; }
.narrow .card-title { font-size:18px; }
.narrow .card-image { height:115px; }
.narrow .card-portrait { height:130px; }
.narrow .card-footer { font-size:13px; }
.narrow .class-image { height:110px; padding:10px; }
.narrow .prepare { flex-direction:column; overflow:visible; padding:8px; }
.narrow .roster { width:100%; min-height:110px; max-height:175px; }
.narrow .roster .unity-scroll-view__content-container { flex-direction:row; flex-wrap:wrap; }
.narrow .roster .dropdown { width:100%; }
.narrow .roster .eyebrow,.narrow .roster-note { display:none; }
.narrow .member { width:19%; flex-direction:column; padding:3px; margin:4px 1px; }
.narrow .member-picture { width:100%; height:35px; margin-right:0; }
.narrow .member-name { font-size:10px; -unity-text-align:middle-center; }
.narrow .member .sub { font-size:9px; -unity-text-align:middle-center; }
.narrow .doll-area { width:100%; min-height:380px; }
.narrow .stats { width:100%; min-height:260px; }
.narrow .prepare > * { margin-right:0; margin-bottom:8px; }
.narrow .doll { height:245px; }
.narrow .slot { width:90px; }
.narrow .doll-picture { width:52%; }
.narrow .camp-title { left:20px; top:18px; }
.narrow .home-title { font-size:26px; }
.narrow .camp-intro,.narrow .camp-footer { display:none; }
.narrow .sortie { width:240px; right:15px; bottom:15px; padding:12px; }
.narrow .camp-label { font-size:9px; padding:8px; }
.narrow .modal-title { font-size:20px; }
.narrow .detail { flex-direction:column; }
.narrow .detail-image,.narrow .detail-portrait { width:100%; height:160px; }
.narrow .detail-body { width:100%; }
.narrow .sheet-foot .camp-button { font-size:13px; padding:8px; }
.narrow .op-title { font-size:27px; }
.narrow .sector-seal { width:145px; height:145px; margin:0 12px; }
.narrow .op-dot { height:30px; }
.narrow .drop-name { font-size:10px; }
.narrow .drop-image { height:50px; }
.narrow .drop-caption { font-size:9px; }
/* Landscape preparation overrides the narrow portrait layout at 590–650 CSS px. */
.narrow.landscape .prepare { flex-direction:row; overflow:hidden; }
.narrow.landscape .roster { width:22%; min-height:0; max-height:none; }
.narrow.landscape .roster .unity-scroll-view__content-container { flex-direction:column; }
.narrow.landscape .roster .eyebrow { display:flex; }
.narrow.landscape .member { width:100%; flex-direction:row; }
.narrow.landscape .member-picture { width:25px; height:28px; }
.narrow.landscape .doll-area { width:auto; min-height:0; }
.narrow.landscape .doll { height:120px; }
.narrow.landscape .slot { width:62px; }
.narrow.landscape .stats { width:23%; min-height:0; }
.narrow.landscape .slot-label { font-size:9px; }
.narrow.landscape .slot-image { height:18px; }
.narrow.landscape .isolated-brand { display:none; }
.card {  -unity-background-scale-mode:stretch-to-fill; }
.card:hover { background-image:none; }
.nav-button.active { background-color:transparent;  -unity-background-scale-mode:stretch-to-fill; }
.camp-scene {  -unity-background-scale-mode:stretch-to-fill; }
.doll { max-width:540px; align-self:center;  -unity-background-scale-mode:stretch-to-fill; }
.slot { background-color:rgba(29,41,36,0.867); }
.operations {  -unity-background-scale-mode:stretch-to-fill; }
.crate { position:relative; }
.crate-layer { position:absolute; width:100%; height:100%; }
.requirement.met .sub { color:#a1dfa8; }
.requirement.missing .sub { color:#ffaaa3; }

.nav-button { flex-direction:row; align-items:center; justify-content:center; }
.nav-icon { font-size:23px; color:#8e9c7b; margin-right:12px; }
.resource-caption { font-size:9px; }
.compact .nav-icon { font-size:18px; margin-right:6px; }
.narrow .nav-button { flex-direction:column; }
.narrow .nav-icon { font-size:19px; margin-right:0; margin-bottom:3px; }

/* Bounded vertical viewports: text wraps inside the visible panel, not an
   unconstrained scroll-content width. The skill tree keeps both-axis scrolling. */
.vertical-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { width:100%; min-width:0; flex-shrink:0; }
.sheet-body { align-items:stretch; }
.sheet-body > * { flex-shrink:0; }
.nav-label { white-space:nowrap; flex-shrink:0; -unity-text-align:middle-center; }
.nav-icon { white-space:nowrap; flex-shrink:0; }
.nav-button { min-width:0; }
.compact .close { padding:4px 10px; }
.compact .op-track > .op-dot { padding:0; }
.pocket-text { width:100%; white-space:normal; flex-shrink:1; }
.pocket-continuation { width:100%; font-size:16px; -unity-text-align:middle-center; }
.bag-cells { justify-content:center; align-self:center; width:100%; }
.setting > .unity-base-field__label { width:48%; min-width:0; flex-shrink:1; white-space:normal; margin-right:8px; }
.setting > .unity-toggle__input { flex-grow:1; flex-shrink:0; padding:0; background-color:transparent; }
.setting .unity-toggle__checkmark { width:22px; height:22px; flex-shrink:0; margin:0; }
.volume-slider { min-width:0; flex-shrink:0; margin:0; }
.volume-slider .unity-base-slider__input { padding:0; min-height:26px; }
.dropdown > .unity-base-field__label { width:32%; min-width:0; flex-shrink:1; }
.dropdown > .unity-base-field__input { min-width:0; flex-grow:1; flex-shrink:1; }
.dropdown .unity-base-popup-field__text { min-width:0; flex-shrink:1; white-space:nowrap; }
.person-modal .detail { margin:4px 0; }
.person-modal .h3 { font-size:18px; margin-bottom:5px; }
.person-modal .paragraph { margin:3px 0 6px; font-size:13px; }
.person-modal .growth-actions { margin:4px 0; }
.person-modal .detail-body > .camp-button { font-size:13px; padding:6px 9px; }
.compact .person-modal .detail-portrait { height:150px; }
.compact .person-modal .growth-line { margin:4px 0; }
.short .op-track { max-width:350px; }
.short .op-track > .op-dot { width:9.5%; height:25px; padding:0; }
.short .sector .paragraph { max-width:100%; }
.narrow .detail-body { flex-basis:auto; }

.compact .prep-tools .camp-button { font-size:12px; padding:5px 8px; }
.person-modal .sheet-foot .camp-button { font-size:13px; padding:6px 10px; }

.doll-area { min-width:0; min-height:0; }
.doll-scroll { flex-grow:1; flex-shrink:1; min-height:0; min-width:0; }

.launcher-slots { justify-content:center; flex-shrink:0; margin:3px 0; }
.launcher-slots > .slot { position:relative; right:auto; bottom:auto; height:68px; margin:0 4px; }
.compact .launcher-slots .slot-image { height:20px; }

.equipment-grid .card-title { font-size:13px; padding:5px 6px; min-height:30px; }
.equipment-grid .card-image { height:75px; padding:2px; }
.equipment-grid .card-footer { padding:5px 6px; min-height:30px; font-size:11px; flex-wrap:wrap; }
.compact .equipment-grid .card-title { font-size:12px; min-height:28px; }
.compact .equipment-grid .card-image { height:56px; }
.compact .equipment-grid .card-footer { font-size:10px; min-height:26px; }
.growth-value { align-items:center; flex-shrink:0; }
.camp-button.growth-plus { width:26px; height:26px; min-width:26px; padding:0; margin-left:4px; font-size:18px; }
.camp-button.growth-plus:disabled { color:#777f73; background-color:#30382f; opacity:0.5; }

/* Compact currency drawer, using the common scrollable modal lifecycle. */
.currency-overlay { align-items:flex-end; justify-content:flex-start; padding:10px; }
.currency-drawer .sheet-body { padding:12px; }
.currency-entry { padding:10px 0; border-bottom-width:1px; border-bottom-color:#465344; }
.currency-name { font-size:18px; white-space:normal; color:#dfbb70; }
.currency-amount { font-size:24px; color:#e4e7d8; }
.currency-entry .paragraph { font-size:15px; white-space:normal; margin-top:4px; }
.resource-button { border-width:0; background-color:rgba(0,0,0,0); padding:0; min-width:0; }

/* Class names keep their word intact; information has its own scrollable sheet. */
.fighter-role { font-size:16px; white-space:nowrap; flex-shrink:0; margin-top:6px; margin-bottom:12px; color:#dfbb70; }
.fighter-info .eyebrow { margin-top:16px; margin-bottom:6px; white-space:normal; }
.fighter-info .stat { flex-direction:column; align-items:flex-start; padding-top:4px; padding-bottom:6px; }
.fighter-info .stat-value { width:auto; max-width:none; white-space:normal; -unity-text-align:middle-left; font-size:18px; }
.fighter-info .paragraph { font-size:16px; white-space:normal; }

/* 0.12.101 — retained Unity camp menu. HUD never enters a ScrollView. */
.hub-player { flex-direction:row; align-items:center; padding:2px 8px; margin-right:8px; min-width:150px; height:58px; background-color:#20271b; border-color:#a18b57; border-radius:8px; }
.hub-avatar { width:47px; height:47px; margin-right:8px; }
.hub-player-copy { justify-content:center; }
.hub-name { font-size:19px; color:#ecdcac; }
.hub-icon { padding:2px; margin:0 5px; background-color:rgba(0,0,0,0); border-width:0; align-items:center; justify-content:center; }
.hub-icon:hover { background-color:rgba(213,185,109,0.12); }
.hub-icon-art { height:65px; width:80px; flex-shrink:1; }
.hub-icon-caption { color:#ead6a1; font-size:12px; -unity-text-align:middle-center; }
.hub-camp .hub-icon-art { width:40px; height:40px; }
.hub-camp .hub-icon-caption { font-size:10px; }
.hub-backdrop { position:absolute; left:0; right:0; top:0; bottom:0; width:100%; height:100%; }
.hub-scene { position:absolute; left:0; right:0; top:0; bottom:0; background-color:#171e13; }
.hub-canvas { position:absolute; }
.hub-building { position:absolute; padding:0; margin:0; border-width:0; background-color:rgba(0,0,0,0); }
.hub-building:hover { background-color:rgba(210,184,103,0.10); }
.hub-building-art { width:100%; height:100%; }
.hub-building-label { position:absolute; bottom:3%; align-self:center; padding:3px 9px; color:#f0ddb0; background-color:#1b2319; border-width:1px; border-color:#b59a59; border-radius:5px; font-size:13px; }
.hub-footer { position:absolute; left:0; right:0; bottom:0; height:88px; align-items:flex-end; padding:3px 14px 7px 14px; background-color:rgba(12,19,13,0.7); }
.hub-chat { width:195px; height:29px; font-size:12px; margin-bottom:3px; }
.hub-social .hub-icon-art { width:25px; height:23px; }
.hub-social .hub-icon-caption { font-size:9px; }
.hub-menu { flex-grow:1; align-items:center; justify-content:center; }
.hub-tile { width:29%; height:85%; max-height:340px; margin:0 2%; padding:12px; background-color:rgba(20,28,20,0.76); border-width:1px; border-color:#978251; border-radius:10px; }
.hub-tile .hub-icon-art { width:100%; height:82%; }
.hub-tile .hub-icon-caption { font-size:19px; margin-top:8px; }
.squad-block { margin:0 0 12px 0; padding:10px; flex-shrink:0; }
.squad-title { align-self:flex-start; margin-bottom:6px; font-size:17px; }
.squad-cards { flex-grow:1; }
.squad-card { width:19%; margin-right:1%; padding:5px; flex-shrink:1; }
.squad-card .card-portrait { height:110px; }
.squad-card .card-title { font-size:16px; }
.squad-card .sub { font-size:11px; white-space:normal; }
.squad-name { width:190px; margin-right:10px; }
.empty-slot { justify-content:center; font-size:16px; }
.compact .hub-player,.short .hub-player { height:34px; min-width:125px; }
.compact .hub-avatar,.short .hub-avatar { width:30px; height:30px; }
.compact .hub-name,.short .hub-name { font-size:14px; }
.compact .hub-player .sub,.short .hub-player .sub { font-size:9px; }
.compact .hub-camp .hub-icon-art,.short .hub-camp .hub-icon-art { width:26px; height:24px; }
.compact .hub-camp .hub-icon-caption,.short .hub-camp .hub-icon-caption { font-size:8px; }
.short .hub-tile { padding:6px; max-height:240px; }
.short .hub-tile .hub-icon-caption { font-size:14px; margin-top:3px; }
.short .hub-footer { height:63px; padding-bottom:3px; }
.short .hub-footer .hub-icon-art { height:42px; width:54px; }
.short .hub-footer .hub-social .hub-icon-art { width:22px; height:20px; }
.short .hub-building-label { font-size:10px; padding:2px 6px; }
.short .squad-block { padding:6px; }
.short .squad-card .card-portrait { height:78px; }
.short .squad-card .card-title { font-size:13px; }
.short .squad-toolbar { padding:3px 8px; }
.narrow .hub-player { min-width:100px; }
.narrow .hub-tile { padding:4px; }
.narrow .hub-tile .hub-icon-caption { font-size:12px; }
.hub-header .resources { position:relative; right:auto; max-width:none; flex-shrink:0; }
.hub-header .settings-button { position:relative; right:auto; margin-left:6px; }
.hub-nav { height:36px; justify-content:flex-start; }
.compact .hub-nav,.short .hub-nav,.narrow .hub-nav { height:32px; }
.hub-nav .hub-back { padding:4px 12px; font-size:12px; }
.compact .hub-building,.short .hub-building { padding:0; border-width:0; }
.compact .hub-icon,.short .hub-icon { padding:2px; }

/* 102: fighter dossier. Portrait composition remains the game renderer. */
.fighter-card-layout { align-items:stretch; flex-grow:1; margin:4px 0; }
.fighter-card-left { width:38%; min-width:115px; flex-shrink:0; align-items:center; margin-right:16px; }
.fighter-card-portrait { width:100%; flex-shrink:0; margin:0 0 8px 0; }
.fighter-card-left .fighter-card-action { width:100%; padding:9px 12px; margin:3px 0; font-size:14px; }
.fighter-biography { flex-grow:1; flex-shrink:1; min-width:0; padding:16px; margin:0; background-color:#202a22; border-color:#596046; }
.fighter-biography .biography-text { white-space:normal; font-size:15px; margin-top:14px; }
.fighter-card-modal .sheet-content { padding-top:4px; }
.compact .fighter-card-left,.short .fighter-card-left { margin-right:12px; }
.compact .fighter-card-left .fighter-card-action,.short .fighter-card-left .fighter-card-action { padding:6px 10px; font-size:12px; }
.short .fighter-biography { padding:10px; }
.short .fighter-biography .biography-text { font-size:13px; margin-top:10px; }
.narrow .fighter-card-left { width:40%; min-width:100px; margin-right:8px; }
.narrow .fighter-biography { padding:8px; }

/* 103: icon-only compact skill tree. Edges route through the gutters. */
.skill-node, .compact .skill-node { width:52px; height:52px; min-height:52px; padding:4px; margin:0; align-items:center; justify-content:center; overflow:visible; }
.skill-icon { width:40px; height:40px; flex-shrink:0; }
.skill-node.locked .skill-icon { opacity:0.48; }
.skill-level { position:absolute; right:0; bottom:0; font-size:10px; height:13px; min-width:14px; padding:0 2px; background-color:#111b15; color:#eee4c3; -unity-text-align:middle-center; }
.skill-check { position:absolute; right:-14px; top:0; color:#e5bd58; font-size:14px; -unity-font-style:bold; }
.skill-node.taken,.skill-node.taken:hover { border-color:#ffe5a0; background-color:#b78b32; color:#fff0bf; }
.skill-node.taken .skill-icon { opacity:1; }
.skill-node.taken .skill-level { background-color:#6b4c14; color:#fff0bf; border-color:#e7bd60; }

/* 104: compact, high-contrast squad name input. */
.squad-toolbar { align-items:center; }
.squad-name { width:160px; min-width:100px; height:30px; margin:0 6px 0 0; flex-shrink:1; font-size:14px; color:#fff5d7; }
.squad-name .unity-text-field__input { background-color:#101912; color:#fff5d7; border-color:#bda56b; border-width:1px; border-radius:4px; padding:3px 7px; -unity-font-style:bold; }
.squad-name .unity-text-input { color:#fff5d7; }
.squad-name .unity-text-field__input:focus { border-color:#f0cd76; background-color:#1a271e; }
.squad-toolbar .camp-button { min-height:30px; padding:3px 9px; font-size:13px; }

/* 105: edge-to-edge camp, independent HUD controls. */
.camp-home .main { position:absolute; left:0; right:0; top:0; bottom:0; }
.camp-home .hub-header { position:absolute; left:0; right:0; top:0; background-color:transparent; border-bottom-width:0; }
.camp-home .hub-footer { background-color:transparent; }
.camp-home .hub-player { background-color:transparent; border-width:0; }
.camp-home .hub-header .resources { background-color:rgba(15,24,17,0.88); border-width:1px; border-color:#8e8054; border-radius:6px; padding:4px 8px; }
.camp-home .hub-header .balance { background-color:transparent; border-width:0; }
.camp-home .settings-button { background-color:transparent; border-width:0; }
.camp-home .hub-chat { background-color:rgba(15,24,17,0.82); }

/* Learned skills occupy the lower right of the fighter card. */
.fighter-bio-copy { flex-grow:1; min-height:65px; }
.fighter-learned { margin-top:10px; padding-top:8px; border-top-width:1px; border-top-color:#596046; flex-shrink:0; }
.fighter-learned-scroll { height:110px; min-height:52px; margin-top:5px; }
.fighter-learned-icons { align-items:flex-start; }
.fighter-learned-icon { width:42px; height:42px; min-height:42px; margin:0 5px 5px 0; padding:4px; background-color:#182219; border-color:#b49b58; }
.fighter-learned-art { width:32px; height:32px; }
.short .fighter-learned-scroll { height:92px; }

/* 0.12.106: independent map anchors and unobstructed HUD. */
.hub-identity { flex-direction:row; align-items:center; flex-shrink:0; padding:3px 6px; background-color:rgba(21,29,21,0.95); border-width:1px; border-color:#aa925b; border-left-width:3px; border-bottom-width:3px; border-bottom-color:#55472e; border-radius:8px; }
.hub-identity .hub-player { background-color:transparent; border-width:0; margin-right:4px; }
.hub-identity .hub-camp { border-left-width:1px; border-left-color:#766742; border-radius:0; padding-left:8px; margin-left:0; margin-right:0; min-width:48px; }
.hub-location-tag { position:absolute; padding:3px 6px; margin:0; font-size:12px; white-space:nowrap; background-color:#1b2319; color:#f0ddb0; border-width:1px; border-color:#b59a59; border-radius:5px; }
.hub-location-tag:hover { background-color:#485035; }
.hub-building { overflow:visible; }
.hub-footer .hub-icon { flex-shrink:0; min-width:64px; overflow:visible; }
.hub-footer .hub-social { min-width:40px; margin-left:3px; margin-right:3px; }
.hub-footer .hub-chat { flex-shrink:1; min-width:100px; max-width:24%; }
.hub-footer .hub-icon-caption { flex-shrink:0; white-space:nowrap; }
.hub-header { overflow:visible; }
.compact .hub-identity,.short .hub-identity { padding:1px 4px; }
.compact .hub-header,.short .hub-header { height:48px; }
.narrow .hub-player { min-width:92px; padding:2px 4px; }
.narrow .hub-name { font-size:14px; }
.narrow .hub-avatar { width:30px; height:30px; margin-right:4px; }
.narrow .hub-player .sub { font-size:9px; }
.narrow .hub-header .resources { padding:2px; }
.narrow .hub-header .resource { font-size:12px; margin-left:3px; margin-right:3px; }
.narrow .hub-header .balance { padding:4px; font-size:13px; }
.narrow .hub-header .settings-button { padding:5px; margin-left:3px; }
.narrow .hub-footer { padding-left:6px; padding-right:6px; }
.narrow .hub-footer .hub-icon { min-width:54px; margin-left:2px; margin-right:2px; }
.narrow .hub-footer .hub-social { min-width:32px; }

.canonical-portrait { overflow:hidden; }
.canonical-art { width:100%; height:100%; flex-grow:1; min-height:0; }

/* 0.12.113: class badges and a subtle non-interactive camp grade. */
.portrait-class-badge { position:absolute; right:4px; bottom:4px; width:28px; height:32px; }
.member .portrait-class-badge { right:2px; bottom:2px; width:18px; height:21px; }
.compact .card-portrait .portrait-class-badge { width:23px; height:26px; }
.camp-mood-filter { position:absolute; left:0; top:0; right:0; bottom:0; background-color:rgba(27,30,31,0.13); }

/* 114: portrait-led cards, bounded header and larger dossier/preparation art. */
.portrait-card { padding:0; overflow:hidden; background-color:#252626; }
.person-heading { flex-shrink:0; align-items:center; height:29px; padding:2px 5px; margin:0; background-color:#252626; }
.person-heading .card-title { font-size:13px; margin:0; padding:0; white-space:nowrap; }
.person-level { font-size:10px; margin-left:3px; margin-right:4px; white-space:nowrap; }
.person-class { width:22px; height:25px; flex-shrink:0; }
.portrait-card .card-portrait { margin:0; padding:0; flex-shrink:0; }
.portrait-card .skill-book { top:auto; bottom:4px; right:4px; }
.fighter-card-left,.narrow .fighter-card-left { width:34%; margin-right:6px; }
.fighter-card-left .fighter-card-action,.compact .fighter-card-left .fighter-card-action,.short .fighter-card-left .fighter-card-action { width:82%; padding:4px 8px; margin:2px 0; font-size:12px; }
.fighter-biography { padding:10px; }
.doll,.compact .doll,.short .doll,.narrow.landscape .doll { height:255px; max-width:none; }
.short .doll,.narrow.landscape .doll { height:205px; }
.doll-picture { width:72%; }
.canonical-art { flex-grow:0; min-height:0; }
.hub-location-tag { font-size:11px; padding:2px 4px; }

/* 116: preserve 114 palette/layout, only narrower right panel and smaller squares. */
.stats { width:19.55%; }
.narrow .stats { width:100%; }
.narrow.landscape .stats { width:19.55%; }
.pocket { width:62px; height:62px; }
.compact .pocket { width:49px; height:49px; }
.short .pocket { width:38px; height:38px; }
.slot-heading { position:absolute; left:0; right:0; top:-18px; height:17px; font-size:10px; -unity-text-align:middle-center; white-space:nowrap; }
.slot.weapon,.slot.armor { top:18px; }

/* 117: one full-area texture per card or preparation column. No child tiles. */
.portrait-card,.portrait-card:hover,.fighter-card-modal,
.prepare > .roster,.prepare > .doll-area,.prepare > .stats {
    background-color:#252626;
    
    -unity-background-scale-mode:stretch-to-fill;
}
.portrait-card .person-heading,.portrait-card .portrait,
.fighter-card-modal .sheet-head,.fighter-card-modal .sheet-content,
.fighter-card-modal .sheet-body,.fighter-card-modal .sheet-foot,
.fighter-card-modal .fighter-card-layout,.fighter-card-modal .fighter-card-left,
.fighter-card-modal .fighter-card-portrait,.fighter-card-modal .fighter-biography,
.fighter-card-modal .fighter-bio-copy,.fighter-card-modal .fighter-learned,
.prepare .doll-scroll,.prepare .doll-title,.prepare .doll,
.prepare .doll-picture,.prepare .kit-cells,.prepare .pocket-group,
.prepare .prep-tools,.prepare .launcher-slots {
    background-image:none;
    background-color:transparent;
}
.prepare .member { background-color:rgba(42,43,43,0.65); border-color:#555656; }
.prepare .member.on { background-color:rgba(92,83,57,0.65); border-color:#dfbb70; }
.prepare .slot,.prepare .pocket { background-color:rgba(42,43,43,0.8); border-color:#555656; }
.prepare .dropdown > .unity-base-field__input { background-color:#303131; border-color:#555656; }

/* 118: tent-backed character editor, bottom squad strip and right drawer. */
.outfit-screen .header { height:48px; padding:3px 12px; background-color:rgba(20,25,22,0.92); }
.outfit-screen .hub-identity { background-color:transparent; border-width:0; padding:0; }
.outfit-screen .hub-camp { border-width:0; padding:0; margin:0; }
.outfit-screen .hub-camp .hub-icon-art { width:30px; height:30px; }
.outfit-screen .hub-camp .hub-icon-caption { font-size:9px; }
.outfit-editor { flex-grow:1; min-height:0; }
.outfit-stage { flex-grow:1; min-height:0; overflow:hidden; }
.outfit-equipment { position:absolute; left:12px; top:16px; bottom:10px; }
.outfit-equipment-scroll { flex-grow:1; min-height:0; }
.outfit-columns { align-items:flex-start; }
.outfit-grid { flex-direction:row; flex-wrap:wrap; flex-shrink:0; }
.outfit-cell { padding:3px; margin:0 5px 5px 0; border-color:#82745a; background-color:rgba(29,31,29,0.86); align-items:center; justify-content:center; }
.outfit-item-art { width:100%; height:100%; }
.outfit-empty { font-size:22px; color:#b5ad91; }
.outfit-strip { align-self:flex-start; font-size:12px; padding:6px 15px; margin-top:5px; }
.outfit-hero { position:absolute; top:4px; right:24px; bottom:0; overflow:hidden; }
.outfit-identity { position:absolute; top:19px; max-width:220px; background-color:rgba(15,18,16,0.28); padding:5px 9px; border-radius:4px; }
.outfit-name { font-size:29px; -unity-font-style:bold; color:#eee3c5; }
.outfit-role { align-items:center; margin-top:3px; }
.outfit-class { width:25px; height:29px; margin-right:6px; }
.outfit-role-name { font-size:13px; color:#ddc794; }
.outfit-drawer { position:absolute; right:0; top:0; bottom:0; width:224px; padding:12px; background-color:#252626;  -unity-background-scale-mode:stretch-to-fill; border-left-width:1px; border-left-color:#82745a; }
.outfit-drawer-scroll { flex-grow:1; min-height:0; }
.outfit-drawer .camp-button { margin-bottom:7px; padding:9px 7px; font-size:13px; }
.outfit-drawer-toggle { position:absolute; top:44%; width:27px; height:54px; padding:0; font-size:30px; color:#e4c576; background-color:rgba(24,26,24,0.9); }
.outfit-footer { height:114px; flex-shrink:0; padding:6px 12px; background-color:#252626;  -unity-background-scale-mode:stretch-to-fill; border-top-width:1px; border-top-color:#82745a; align-items:center; }
.outfit-footer-controls { width:94px; flex-shrink:0; margin-right:10px; }
.outfit-footer-controls .camp-button { padding:6px 5px; font-size:12px; }
.outfit-squad-caption { font-size:11px; margin-top:5px; white-space:normal; color:#d1bd8c; }
.outfit-roster { flex-grow:1; min-width:0; height:100%; }
.outfit-roster-row { align-items:center; }
.outfit-member { width:86px; height:94px; padding:0; margin:0 6px 0 0; background-color:rgba(30,31,31,0.65); border-color:#6b6a61; justify-content:flex-end; overflow:hidden; }
.outfit-member.selected { border-color:#dfbb70; border-width:2px; background-color:rgba(107,90,49,0.4); }
.outfit-thumbnail { position:absolute; left:0; top:0; right:0; bottom:17px; overflow:hidden; }
.outfit-member-name { font-size:11px; height:17px; -unity-text-align:middle-center; background-color:rgba(20,22,21,0.85); }
.squad-heading-row { align-items:center; }
.squad-rename { width:30px; height:30px; padding:0; margin-left:6px; font-size:19px; }
.short .outfit-footer { height:94px; padding-top:4px; padding-bottom:4px; }
.short .outfit-member { height:78px; width:74px; }
.short .outfit-name { font-size:24px; }
.outfit-screen.short .header { height:44px; }

/* 119: four full equipment rows, section rule and roster metadata. */
.outfit-cell { flex-shrink:0; min-width:0; min-height:0; }
.outfit-equipment-divider { width:100%; height:1px; flex-shrink:0; margin-top:2px; margin-bottom:7px; background-color:#9b8964; }
.outfit-squad-heading { align-items:center; margin-top:4px; }
.outfit-squad-caption { flex-grow:1; flex-shrink:1; min-width:0; margin-top:0; }
.outfit-footer-controls .outfit-rename { width:23px; height:23px; min-width:23px; flex-shrink:0; padding:0; margin-left:3px; font-size:16px; }
.outfit-thumbnail { bottom:30px; }
.outfit-member-name { height:15px; font-size:10px; flex-shrink:0; margin:0; }
.outfit-member-meta { height:15px; flex-shrink:0; align-items:center; justify-content:space-between; padding:0 5px; background-color:rgba(20,22,21,0.9); }
.outfit-member-level { font-size:9px; margin:0; color:#d1bd8c; }
.outfit-member-class { width:14px; height:14px; flex-shrink:0; }

/* 120: compact button padding must not shrink equipment illustrations. */
.outfit-screen .outfit-cell { padding:2px; }
.outfit-screen .outfit-cell .outfit-item-art { position:absolute; left:2px; right:2px; top:2px; bottom:2px; width:auto; height:auto; margin:0; padding:0; flex-shrink:0; }

/* Player profile: shared head layers, no separate avatar atlas. */
.profile-modal .sheet-body { padding:12px; }
.profile-top { align-items:center; margin-bottom:10px; }
.profile-avatar-button { width:88px; height:88px; padding:5px; margin-right:14px; flex-shrink:0; background-color:#202a25; border-color:#a89359; border-width:1px; }
.profile-avatar { width:100%; height:100%; }
.profile-identity { flex-grow:1; min-width:0; }
.profile-name-row { align-items:center; }
.profile-name { flex-grow:1; min-width:0; font-size:22px; -unity-font-style:bold; white-space:normal; }
.profile-edit { width:34px; min-width:34px; height:30px; padding:0; margin-left:8px; }
.profile-level { font-size:14px; margin-top:4px; }
.profile-xp-track { height:10px; background-color:#151b18; margin-top:5px; overflow:hidden; }
.profile-xp-fill { height:100%; background-color:#a1af6a; }
.profile-xp-caption { font-size:12px; color:#c4c7b8; margin-top:3px; }
.profile-future { min-height:42px; padding:12px; margin-bottom:10px; background-color:#202621; border-color:#414a40; border-width:1px; justify-content:center; }
.profile-fighters { flex-direction:row; flex-wrap:nowrap; margin-top:5px; }
.profile-fighter { position:relative; width:19%; flex-grow:1; min-width:0; margin-right:4px; padding:4px; padding-bottom:28px; background-color:#242c27; border-color:#626b55; border-width:1px; }
.profile-fighter-picture { width:100%; height:155px; min-height:0; overflow:hidden; }
.profile-fighter-name { font-size:13px; white-space:normal; -unity-text-align:middle-center; }
.profile-fighter-level { position:absolute; right:5px; bottom:4px; font-size:12px; color:#d5c38a; -unity-text-align:middle-right; }
.profile-fighter-class { position:absolute; left:4px; bottom:3px; width:22px; height:22px; }
.profile-empty { height:155px; -unity-text-align:middle-center; }
.profile-actions { flex-wrap:wrap; justify-content:space-between; }
.profile-action { flex-grow:1; margin:3px; min-width:85px; white-space:normal; }
.profile-action:disabled { opacity:0.35; }
.profile-avatar-grid { flex-direction:row; flex-wrap:wrap; justify-content:center; }
.profile-avatar-cell { width:76px; height:82px; margin:4px; padding:4px; background-color:#202a25; border-color:#53604e; border-width:1px; }
.profile-avatar-cell.selected { border-color:#e1c879; border-width:2px; background-color:#3d4934; }
.profile-avatar-thumb { width:100%; height:100%; }
.profile-nickname-input { height:38px; margin-top:8px; font-size:18px; }
.narrow .profile-avatar-button { width:65px; height:70px; margin-right:8px; }
.narrow .profile-name { font-size:18px; }
.narrow .profile-fighter { padding:2px; padding-bottom:26px; margin-right:2px; }
.narrow .profile-fighter-picture,.narrow .profile-empty { height:104px; }
.narrow .profile-fighter-name { font-size:10px; }
.narrow .profile-action { width:45%; }
.short .profile-fighter-picture,.short .profile-empty { height:90px; }
.short .profile-avatar-button { width:64px; height:64px; }
.short .profile-future { min-height:28px; padding:6px; margin-bottom:5px; }
.hub-player-copy { min-width:0; max-width:160px; }
.hub-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.narrow .hub-player-copy { max-width:76px; }
.profile-header-button { margin-left:6px; padding:5px 8px; font-size:12px; }

.shop-groups { flex-wrap:wrap; }
.rare-item { border-color:#6c9dd5; border-width:2px; }
.item-rarity { color:#8bbbf2; font-size:11px; -unity-font-style:bold; margin-bottom:3px; }

/* Equipment cards: stable typography; only the body scrolls. */
.equipment-modal .sheet-head { padding:6px 12px; min-height:44px; }
.equipment-modal .modal-title { font-size:20px; white-space:normal; }
.equipment-modal .close { min-width:44px; min-height:44px; padding:2px 8px; }
.equipment-modal .sheet-content { padding:8px 12px; }
.equipment-modal .sheet-foot { padding:6px 10px; flex-wrap:wrap; }
.equipment-modal .sheet-foot > .camp-button { flex-grow:1; flex-basis:0; min-width:110px; min-height:44px; padding:8px 10px; font-size:15px; margin:2px 4px; }
.equipment-header { align-items:center; margin-bottom:8px; }
.equipment-header > .outfit-item-art { width:80px; height:80px; flex-shrink:0; margin-right:12px; }
.equipment-summary { min-width:0; }
.equipment-summary .h3 { font-size:18px; margin-bottom:4px; white-space:normal; }
.equipment-summary .item-rarity { font-size:13px; }
.equipment-columns { align-items:flex-start; }
.equipment-columns > .equipment-column { width:auto; flex-basis:0; flex-grow:1; flex-shrink:1; min-width:0; padding:0; margin-right:12px; }
.equipment-meta { white-space:normal; font-size:14px; margin-top:3px; }
.equipment-section { font-size:15px; -unity-text-align:middle-center; -unity-font-style:bold; border-top-width:1px; border-top-color:#758262; padding-top:7px; margin-bottom:5px; }
.equipment-stat { flex-direction:row; flex-wrap:wrap; align-items:center; padding:6px 0; border-bottom-width:1px; border-bottom-color:#455045; }
.equipment-stat-name { font-size:14px; color:#d2d8cb; white-space:normal; margin-right:6px; }
.equipment-values { flex-wrap:wrap; min-width:0; flex-shrink:1; }
.equipment-values > * { margin-right:0; }
.equipment-stat-value { font-size:15px; -unity-font-style:bold; white-space:normal; }
.equipment-stat-bonus { color:#8cdeb0; font-size:15px; margin-left:5px; -unity-font-style:bold; white-space:normal; }
.equipment-stat-penalty { color:#f0a08d; }
.equipment-note { font-size:14px; white-space:normal; color:#c4cdbf; margin-top:10px; }
.equipment-explain { font-size:14px; min-height:44px; padding:7px 9px; margin-top:8px; background-color:transparent; -unity-text-align:middle-left; }
.equipment-remove { background-color:#763e35; }
.equipment-phone .equipment-header { flex-direction:row; align-items:flex-start; }
.equipment-phone .equipment-header > .outfit-item-art { width:62px; height:62px; margin-right:8px; }
.equipment-phone .equipment-columns { flex-direction:column; }
.equipment-phone .equipment-columns > .equipment-column { width:100%; flex-basis:auto; margin-right:0; }
.equipment-phone .equipment-summary .h3 { font-size:17px; }
.equipment-phone .equipment-stat { padding:7px 0; }
.short .equipment-header > .outfit-item-art { width:64px; height:64px; }
.short .equipment-header { margin-bottom:5px; }
.short .equipment-stat { padding:4px 0; }
.fighter-statistics .equipment-section { margin-top:14px; }
.fighter-statistics .fighter-role { font-size:18px; }
.equipment-skill { min-height:44px; font-size:14px; padding:8px 10px; margin-top:5px; -unity-text-align:middle-left; }

.ui-scale-slider { width:100%; min-width:0; min-height:30px; margin-bottom:6px; }

/* Inventory and shop: independent screens, inline item inspection. */
.store-shade { position:absolute; left:0; right:0; top:0; bottom:0; background-color:rgba(8,12,10,0.58); }
.inventory-page { flex-grow:1; min-height:0; padding:8px; }
.inventory-page .list-heading { margin-bottom:6px; }
.inventory-body { flex-grow:1; min-height:0; align-items:stretch; }
.inventory-categories { width:10%; min-width:84px; max-width:112px; flex-shrink:0; margin-right:8px; background-color:rgba(18,24,20,0.8); }
.inventory-categories .camp-button { min-height:44px; white-space:normal; margin:3px; font-size:15px; -unity-text-align:middle-left; }
.inventory-list { flex-grow:1; flex-basis:0; min-width:0; margin-right:8px; }
.inventory-grid { padding:2px; }
.inventory-cell { height:142px; padding:4px; position:relative; background-color:rgba(31,40,32,0.9); border-width:2px; border-color:#69725d; flex-shrink:0; }
.inventory-cell.rare-item { border-color:#c39a57; background-color:rgba(72,51,35,0.9); }
.inventory-cell.selected { border-color:#ffe394; background-color:rgba(91,87,48,0.95); }
.inventory-cell .outfit-item-art { width:100%; height:88px; flex-shrink:0; }
.inventory-item-name { font-size:12px; white-space:normal; -unity-text-align:middle-center; }
.inventory-item-amount { position:absolute; bottom:3px; right:5px; font-size:12px; color:#ffe5a3; background-color:rgba(12,17,13,0.85); padding:1px 3px; }
.inventory-resource-icon { height:88px; font-size:42px; -unity-text-align:middle-center; }
.inventory-detail { width:23%; min-width:180px; max-width:300px; min-height:0; flex-shrink:0; background-color:rgba(19,27,22,0.94); border-width:1px; border-color:#727961; }
.inventory-detail-scroll { flex-grow:1; min-height:0; padding:10px; }
.inventory-actions { padding:6px; flex-shrink:0; }
.inventory-actions .camp-button { white-space:normal; min-height:44px; }
.inventory-detail .equipment-header { flex-direction:column; align-items:stretch; }
.inventory-detail .equipment-header > .outfit-item-art { width:100%; height:100px; margin-right:0; }
.inventory-detail .equipment-columns { flex-direction:column; }
.inventory-detail .equipment-column { width:100%; flex-basis:auto; margin-right:0; }
.inventory-detail .equipment-stat { padding:5px 0; }
.inventory-detail .equipment-summary .h3 { font-size:18px; }
.inventory-detail .equipment-meta { font-size:13px; }
.inventory-detail .equipment-explain { white-space:normal; }
.short .inventory-categories { width:10%; }
.short .inventory-cell { height:124px; }
.short .inventory-cell .outfit-item-art { height:72px; }

.inventory-viewport { flex-grow:1; min-height:0; }
.inventory-body > * { margin-right:8px; }
.inventory-detail { margin-right:0; }

/* Compact equal square inventory tiles: eight columns at every viewport width. */
.inventory-page { padding:4px 8px; }
.inventory-page .list-heading { margin-bottom:4px; }
.inventory-page .h1 { font-size:20px; }
.inventory-body { min-width:0; flex-shrink:1; }
.inventory-categories { width:10%; min-width:68px; max-width:100px; margin-right:5px; }
.inventory-categories .camp-button { min-width:0; min-height:30px; padding:5px 3px; margin:2px; font-size:11px; white-space:normal; }
.inventory-categories Image { width:16px; height:16px; }
.inventory-list { margin-right:5px; min-height:0; }
.inventory-grid { padding:2px; min-width:0; align-items:flex-start; flex-shrink:0; }
.inventory-cell, .short .inventory-cell { min-width:0; min-height:0; padding:2px; margin-left:0; margin-top:0; border-width:1px; }
.inventory-cell .outfit-item-art, .short .inventory-cell .outfit-item-art { position:absolute; left:2px; right:2px; top:2px; bottom:12px; width:auto; height:auto; }
.inventory-item-amount { font-size:9px; bottom:1px; right:1px; padding:0 2px; }
.inventory-resource-icon { height:auto; flex-grow:1; font-size:22px; }
.inventory-detail { min-width:140px; }
.inventory-detail-scroll { padding:6px; }
.inventory-detail .equipment-header > .outfit-item-art { height:64px; }
.inventory-detail .equipment-summary .h3 { font-size:15px; }
.inventory-detail .equipment-meta, .inventory-detail .equipment-stat-name, .inventory-detail .equipment-stat-value { font-size:11px; }
.inventory-detail .equipment-section { font-size:12px; }
.inventory-detail .equipment-explain { font-size:11px; min-height:30px; }
.inventory-actions .camp-button { font-size:12px; min-height:32px; padding:5px; }

.outfit-formation { flex-direction:column; align-items:center; justify-content:flex-start; align-self:flex-start; flex-shrink:0; width:36px; min-width:36px; height:36px; margin-left:6px; padding:4px; background-color:transparent; border-width:0; }
.outfit-formation-icon { width:28px; height:28px; flex-shrink:0; -unity-background-scale-mode:scale-to-fit; }
.outfit-formation-caption { display:none; font-size:12px; color:#dac48a; -unity-text-align:middle-center; white-space:nowrap; }
.outfit-formation:hover { background-color:rgba(208,182,111,0.12); }
.outfit-formation:focus { border-width:1px; border-color:#ddc580; }
.outfit-formation:disabled { opacity:0.4; }

/* Workshop owns its density; generic modal/card headings must not expand this layout. */
.workshop { padding:0; }
.workshop-head { padding:6px 12px; align-items:center; flex-shrink:0; border-bottom-width:1px; border-bottom-color:#53624c; }
.workshop .modal-title { font-size:20px; }
.workshop > .sub { padding:3px 10px; font-size:11px; flex-shrink:0; }
.workshop-body { padding:8px; }
.workshop-nav { margin-right:10px; }
.workshop-center { margin-right:12px; }
.workshop .h2 { font-size:18px; margin-bottom:8px; }
.workshop .paragraph { font-size:13px; margin-top:4px; margin-bottom:6px; }
.workshop .sub { font-size:11px; }
.workshop .stat { font-size:12px; padding:5px 0; }
.workshop-rank { font-size:16px; margin-bottom:4px; }
.workshop .camp-button { font-size:13px; min-height:32px; padding:4px 6px; margin:2px 0; flex-shrink:0; }
.workshop .drop-card { padding:0; margin-bottom:4px; }
.workshop-right > .row { align-items:center; }
.workshop-compact .modal-title { font-size:16px; }
.workshop-compact .h2 { font-size:15px; margin-bottom:5px; }
.workshop-compact .paragraph { font-size:12px; }
.workshop-compact .camp-button { font-size:12px; min-height:28px; padding:3px 4px; }
.workshop-compact .workshop-rank { font-size:14px; }
.workshop-compact .workshop-body { padding:4px 6px; }
.workshop-compact .workshop-head { padding:3px 8px; }
