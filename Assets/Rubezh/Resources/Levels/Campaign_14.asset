  m_Name: Campaign_14
  displayName: Недострой
  m_EditorClassIdentifier: ''
  formatVersion: 6
  campaignMission: 14
  columns: 58
  rows: 34
  theme: 5
  enabledInGame: true
  useInQuickBattle: false
  customDefenders: true
  greenVehicleArrival: false
  overrideBriefing: true
  operationDescription: За парком начался недостроенный район. Бетонные коробки, обломки, горы строительного мусора — хоть какое-то укрытие. Только голову подняли, и снова прилёт. Откуда у них столько гранатомётов?!
  expectedThreats: Два гранатомёта; плотная группа за одним укрытием особенно уязвима. Один гранатомётчик имеет РПГ и подствольник, второй — РШГ. Низкие барьеры не ослабляют взрыв РШГ.
  flag:
    m_X: 54
    m_Y: 17
  playerSpawn:
    m_X: 3
    m_Y: 17
  botSpawn:
    m_X: 51
    m_Y: 17
