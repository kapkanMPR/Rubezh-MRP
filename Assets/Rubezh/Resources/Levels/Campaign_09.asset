  overrideBriefing: true
  operationDescription: В укрытии преследователей нашли документы с планами противника. Их нужно срочно доставить нашим на соседний рубеж. Короткий путь лежит через лес. Очень хочется верить, что там нас
    никто не ждёт.
  expectedThreats: Длинные открытые промежутки; встречаются пулемёт, медик и гранатомёт. У стрелка есть ручные гранаты для ближнего рубежа.
  flag:
    m_X: 50
    m_Y: 15
  playerSpawn:
    m_X: 3
    m_Y: 15
